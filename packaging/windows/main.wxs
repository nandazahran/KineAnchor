<!-- WiX v6 (v4 schema) installer. Built with: wix build packaging/windows/main.wxs -arch x64 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package
        Name="KineAnchor"
        Manufacturer="KineAnchor Contributors"
        Version="0.1.1"
        UpgradeCode="94B2B8E1-6C74-4D3A-9C35-38E4F7D0A474"
        ProductCode="{6C28D5FA-9E4C-458B-A213-94E237157474}"
        Language="1033"
        Codepage="1252"
        Scope="perMachine"
        InstallerVersion="500"
        Compressed="yes">

        <SummaryInformation
            Description="FOSS Cross-Platform Motion Sickness Overlay (GPL-3.0-or-later)"
            Manufacturer="KineAnchor Contributors"/>

        <MajorUpgrade
            Schedule="afterInstallInitialize"
            DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit."/>

        <MediaTemplate EmbedCab="yes"/>

        <Feature
            Id="Binaries"
            Title="KineAnchor"
            Description="Installs the KineAnchor desktop executable and Start Menu shortcut."
            Level="1"
            AllowAbsent="no">
            <ComponentRef Id="MainExecutable"/>
            <ComponentRef Id="ApplicationShortcut"/>
        </Feature>

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="APPLICATIONFOLDER" Name="KineAnchor">
                <Component Id="MainExecutable" Guid="5C4E1AE7-2B13-4E1D-9F63-7A0E5B3D2474">
                    <File Id="kineanchor_exe" Source="target\release\kineanchor.exe" KeyPath="yes"/>
                </Component>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="KineAnchor">
                <Component Id="ApplicationShortcut" Guid="A93F2184-10B2-45E1-9F1C-724851047474">
                    <Shortcut
                        Id="ApplicationStartMenuShortcut"
                        Name="KineAnchor"
                        Description="Motion Sickness Peripheral Overlay"
                        Target="[APPLICATIONFOLDER]kineanchor.exe"
                        WorkingDirectory="APPLICATIONFOLDER"/>
                    <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
                    <RegistryValue
                        Root="HKCU"
                        Key="Software\KineAnchor"
                        Name="installed"
                        Type="integer"
                        Value="1"
                        KeyPath="yes"/>
                </Component>
            </Directory>
        </StandardDirectory>
    </Package>
</Wix>
