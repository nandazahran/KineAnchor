<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>KineAnchor</vendor>
  <vendor_url>https://github.com/nandazahran/KineAnchor</vendor_url>
  <action id="io.github.nandazahran.kineanchor.netsetup">
    <description>Configure USB tethering route metric and local port 47474 for KineAnchor</description>
    <message>Authentication is required to configure USB tethering priority and allow KineAnchor phone sensor connections.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kineanchor/kineanchor-netsetup</annotate>
  </action>
</policyconfig>
