# Maintainer: Nanda Zahran <https://github.com/nandazahran>
pkgname=kineanchor
pkgver=0.1.0
pkgrel=1
pkgdesc="Cross-platform motion sickness overlay (Wayland wlr-layer-shell & X11)"
arch=('x86_64' 'aarch64')
url="https://github.com/nandazahran/KineAnchor"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'wayland' 'libxkbcommon')
makedepends=('cargo')
optdepends=(
  'networkmanager: automatic USB tether route metric profile'
  'polkit: one-click network & firewall setup from GUI'
)
# Released source tarball, not the caller's checkout.
source=("https://github.com/nandazahran/KineAnchor/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('0019dfc4b32d63c1392aa264aed2253c1e0c2fb09216f8e2cc269bbfb8bb49b5')

prepare() {
  cd "${srcdir}/KineAnchor-${pkgver}"
  # Build offline against the vendored lockfile.
  cargo fetch --locked
}

build() {
  cd "${srcdir}/KineAnchor-v${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo build --frozen --release -p kineanchor
}

check() {
  cd "${srcdir}/KineAnchor-v${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo test --frozen --workspace
}

package() {
  cd "${srcdir}/KineAnchor-v${pkgver}"
  install -Dm755 "${srcdir}/target/release/kineanchor" "$pkgdir/usr/bin/kineanchor"
  install -Dm755 "packaging/linux/kineanchor-netsetup" "$pkgdir/usr/lib/kineanchor/kineanchor-netsetup"
  install -Dm644 "packaging/linux/90-kineanchor-tether.nmconnection" \
    "$pkgdir/usr/share/kineanchor/90-kineanchor-tether.nmconnection"
  install -Dm644 "packaging/linux/io.github.nandazahran.kineanchor.policy" \
    "$pkgdir/usr/share/polkit-1/actions/io.github.nandazahran.kineanchor.policy"
  install -Dm644 "packaging/linux/io.github.nandazahran.kineanchor.desktop" \
    "$pkgdir/usr/share/applications/io.github.nandazahran.kineanchor.desktop"
  install -Dm644 "packaging/linux/ufw-kineanchor" \
    "$pkgdir/etc/ufw/applications.d/kineanchor"
  install -Dm644 "packaging/linux/firewalld-kineanchor.xml" \
    "$pkgdir/usr/lib/firewalld/services/kineanchor.xml"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Optional GNOME integration ships as data only; nothing is installed or enabled globally.
  install -d "$pkgdir/usr/share/kineanchor/gnome-extension"
  install -Dm644 "packaging/gnome-extension/extension.js" \
    "$pkgdir/usr/share/kineanchor/gnome-extension/extension.js"
  install -Dm644 "packaging/gnome-extension/metadata.json" \
    "$pkgdir/usr/share/kineanchor/gnome-extension/metadata.json"
}
